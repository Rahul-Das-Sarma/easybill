# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="sb_publishable_..."

# Legacy (optional): still read if publishable key is unset
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Vercel / production Auth checklist (Supabase Dashboard → Authentication → URL Configuration):
# - Site URL = https://your-app.vercel.app
# - Redirect URLs include:
#     https://your-app.vercel.app/**
#     https://your-app.vercel.app/auth/callback
# After changing NEXT_PUBLIC_* on Vercel, Redeploy (they are baked in at build time).

# Server-only: upload invoice PDFs & create signed URLs (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="[service-role-secret]"

# Storage bucket for generated PDFs (create as private in Supabase Dashboard)
SUPABASE_INVOICE_PDF_BUCKET="invoice-pdfs"
# Storage bucket for company logos (typically public for direct rendering)
SUPABASE_COMPANY_LOGO_BUCKET="company-logos"

# Email (https://resend.com)
RESEND_API_KEY="re_..."
# Optional; default is Resend onboarding sender
# RESEND_FROM_EMAIL="EasyBill <billing@yourdomain.com>"

# --- Database (critical for Vercel) ---
#
# Direct host db.[ref].supabase.co is often IPv6-only → fails on Vercel.
# Use Transaction pooler for the app (port 6543). Copy from:
#   Supabase → Project Settings → Database → Connection string → Transaction pooler
#
# Username is postgres.[ref] (not just postgres). Encode special chars in password (@ → %40).
#
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]%40encoded@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct URL for prisma migrate only (local / CI):
DIRECT_URL="postgresql://postgres:[PASSWORD]%40encoded@db.[ref].supabase.co:5432/postgres"
